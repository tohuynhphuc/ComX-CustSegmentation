      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{3167D4E4-998E-43AE-A36A-875E85E3A274}"
          SQLTask:SqlStatementSource="SELECT CONVERT(VARCHAR(36), NEWID()) AS BatchID;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
