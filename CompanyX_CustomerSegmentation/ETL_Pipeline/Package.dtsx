              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    h.SalesOrderID,
    d.SalesOrderDetailID,

    CONVERT(NVARCHAR(20), h.CustomerID)
        AS CustomerKey_Str,

    d.ProductID,

    CONVERT(
        INT,
        CONVERT(CHAR(8), h.OrderDate, 112)
    ) AS OrderDateKey,

    d.OrderQty,

    CONVERT(DECIMAL(19,4), d.UnitPrice)
        AS UnitPrice,

    CONVERT(DECIMAL(19,4), d.LineTotal)
        AS SalesAmount,

    d.ModifiedDate

FROM Sales.SalesOrderHeader AS h

INNER JOIN Sales.SalesOrderDetail AS d
    ON h.SalesOrderID = d.SalesOrderID

INNER JOIN CompanyX_DataWarehouse.dbo.DimCustomerProfiling AS c
    ON c.CustomerKey_Str =
       CONVERT(NVARCHAR(20), h.CustomerID)

WHERE NOT EXISTS (
    SELECT 1
    FROM CompanyX_DataWarehouse.dbo.FactSales AS f
    WHERE f.SalesOrderID = h.SalesOrderID
      AND f.SalesOrderDetailID = d.SalesOrderDetailID
);</property>
